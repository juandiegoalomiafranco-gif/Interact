# ─────────────────────────────────────────────────────────────
# Airtable — SOLO SERVIDOR. Ninguna de estas lleva NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────────

# Personal Access Token de Airtable.
# Scopes: data.records:read, data.records:write y schema.bases:read.
# SIN schema.bases:write — la app no crea ni borra tablas ni campos.
# Access: solo la base de finanzas del club.
# Se crea o edita en https://airtable.com/create/tokens
#
# Con escritura, un token filtrado puede MODIFICAR la contabilidad, no solo
# leerla. Las barreras (tres tablas, sin DELETE, EDITOR_EMAILS) son de código
# y no protegen contra alguien que tenga el token en la mano: si sospechas
# que se filtró, rótalo.
AIRTABLE_TOKEN=

# ID de la base de finanzas
AIRTABLE_BASE_ID=app4obzS9ct8HxQQU

# Cada cuánto se refresca el caché, en segundos.
# 43200 = 12 h ≈ 900 llamadas/mes, dentro de las 1.000 del plan gratuito.
# Bajarlo agota la cuota: a 3600 (1 h) se acaba en tres días.
AIRTABLE_REVALIDATE_SECONDS=43200

# Ponlo en 1 durante desarrollo para servir desde .cache/ y no gastar llamadas.
AIRTABLE_DEV_CACHE=

# ─────────────────────────────────────────────────────────────
# Autenticación
# ─────────────────────────────────────────────────────────────

# Genera uno con:  npx auth secret
AUTH_SECRET=

# Google Cloud Console → Credenciales → ID de cliente OAuth → Aplicación web
# Redirect URIs: http://localhost:3000/api/auth/callback/google
#                https://TU-APP.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# En Vercel: la URL de producción
AUTH_URL=http://localhost:3000

# Quién PUEDE VER. Correos separados por coma.
# Quien no esté aquí no entra, aunque tenga cuenta de Google.
# Vacía = no entra nadie. Nunca significa "sin restricciones".
ALLOWED_EMAILS=

# Quién PUEDE REGISTRAR información. Debe ser un subconjunto de ALLOWED_EMAILS:
# poder escribir sin poder entrar es una contradicción, y se comprueba en cada
# escritura. Vacía = nadie escribe, aunque sí pueda ver.
EDITOR_EMAILS=

# Apaga la telemetría de build de Next. El brief pide cero tracking.
NEXT_TELEMETRY_DISABLED=1
